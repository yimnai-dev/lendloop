# Copy to .env.docker (gitignored). Read by docker compose for the n8n container.
# Generate each secret with: openssl rand -hex 32

# Must equal the Convex env var of the same name (Convex signs, n8n verifies).
CONVEX_TO_N8N_SECRET=
# Must equal the Convex env var of the same name (n8n signs, Convex verifies).
N8N_TO_CONVEX_SECRET=
# Encrypts n8n credentials at rest. Keep it stable or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=
