# --- Next.js (.env.local) ---
# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Written by `clerk init` (or copy from the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tools
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/tools
# Neighborhood time zone used for "today" in the UI
NEXT_PUBLIC_APP_TZ=UTC

# --- Convex deployment env (set with `bunx convex env set NAME value`) ---
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
# CLERK_WEBHOOK_SECRET=whsec_...
# ADMIN_EMAILS=you@example.com
# APP_TZ=UTC
# N8N_NOTIFY_WEBHOOK_URL=https://<n8n>/webhook/lendloop-notify
# CONVEX_TO_N8N_SECRET=<random 32+ bytes>
# N8N_TO_CONVEX_SECRET=<random 32+ bytes>
