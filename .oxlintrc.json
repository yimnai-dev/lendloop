{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect", "useLayoutEffect"],
            "message": "Derive state instead of syncing it. See docs/DESIGN.md (no useEffect)."
          },
          {
            "name": "effect",
            "message": "Import from submodules (e.g. effect/Effect) to keep Convex cold starts fast."
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "unicorn/no-null": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-sort": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "_id", "_creationTime", "_storage", "_scheduled_functions"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "temporal-polyfill/global"]
      }
    ]
  },
  "ignorePatterns": [
    "**/_generated/**",
    "convex/**",
    "components/ui/**",
    "next-env.d.ts",
    ".next/**"
  ]
}
